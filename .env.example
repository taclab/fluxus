# Copier vers .env puis adapter.
POSTGRES_USER=fluxus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fluxus

# Chaîne utilisée par l'API et le worker (le hôte "postgres" est le service compose)
DATABASE_URL=postgresql+asyncpg://fluxus:change-me@postgres:5432/fluxus

# Secret pour signer les JWT et chiffrer les clés LLM stockées. 32+ caractères aléatoires.
FLUXUS_SECRET_KEY=change-me-to-a-long-random-string

# URL interne du service de rendu navigateur (repli extraction)
FLUXUS_BROWSER_URL=http://browser:3000

# Port publié sur l'hôte pour l'API (à raccorder au reverse proxy)
FLUXUS_HTTP_PORT=8000
# Port hôte pour Postgres en dev (5432 est souvent déjà pris)
FLUXUS_PG_PORT=5433
